[Unit]
Description=Bloodraven Telegram bridge for Codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@USER@@
Group=@@GROUP@@
Environment=HOME=@@HOME@@
EnvironmentFile=/etc/bloodraven/bloodraven.env
WorkingDirectory=/opt/bloodraven
ExecStart=@@DOTNET@@ /opt/bloodraven/Bloodraven.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
